AW{"type":"javascript"}

AndrewWIDE.loadWasmDSPModules(['signal'])

AW{"type":"javascript"}

let bq = new AndrewWIDE.WasmDSP.modules.signal.Biquad(1,0,1,-1.9,0.97);
let x=[1];
for (let i=0; i<400; i++) x.push(0);
let resp = bq.process(x);
plot(resp);
let bq1 = new AndrewWIDE.WasmDSP.modules.signal.Biquad(1,0,1,-1.8,0.97);
let resp1 = bq1.process(x);
plot(resp1);

